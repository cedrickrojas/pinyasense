# Twilio SMS Configuration
# Get these values from https://www.twilio.com/console

# Your Twilio Account SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number (the "from" number for SMS)
# Format: +1234567890 (country code + number)
TWILIO_FROM_NUMBER=+1234567890

# Optional: Custom SMS message template
# Use {dry_days} as placeholder for number of days
# SOIL_DRY_NOTIFICATION_MESSAGE="Custom message with {dry_days} days dry"
