# Sample .env file for AgriPinya
# Copy this to .env and update with your values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=5001
APP_BASE_URL=https://xn--piasense-e3a.tech

# Required for remote Arduino ingestion; blank permits local loopback requests only.
# Send the same value with the bridge's --token option or SENSOR_INGEST_TOKEN env var.
SENSOR_INGEST_TOKEN=
WATER_PUMP_MAX_DURATION_SECONDS=300

# Scheduled reports are sent only to explicitly configured recipients.
REPORT_RECIPIENTS=

# Database (for future use)
DATABASE_URI=sqlite:///agripinya.db

# Upload Configuration
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes

# Model Configuration
MODEL_PATH=models/pineapple_disease_model_latest.h5

# Logging
LOG_LEVEL=INFO
LOG_FILE=agripinya.log

# ============================================
# GPIO Sensor/Relay Configuration
# ============================================

# Capacitive soil moisture sensors, one per zone (comma-separated GPIO pins).
# Default wiring: 4 sensors on GPIO 22, 23, 24, 25.
SOIL_MOISTURE_PINS=22,23,24,25

# Primary/legacy single soil sensor pin (defaults to the first pin in SOIL_MOISTURE_PINS).
SOIL_MOISTURE_PIN=22

# Water pump relay pin
WATER_PUMP_PIN=27
WATER_PUMP_ACTIVE_LOW=0

# On the Windows/web host: forward pump controls to the Pi app.
# Leave PUMP_REMOTE_URL empty on the Pi itself.
# Example for Windows: PUMP_REMOTE_URL=http://voicebrain.local:5001
PUMP_REMOTE_URL=
# Same random secret (at least 32 characters) on both hosts. Never put in browser JS.
PUMP_BRIDGE_TOKEN=

# How to decide watering from multiple soil zones: any | all | majority
# any = water if ANY zone is dry (default), all = only if EVERY zone is dry,
# majority = water if more than half of zones are dry.
SOIL_ZONE_WATER_POLICY=any

# ============================================
# Firebase Configuration (Optional)
# ============================================
# Leave empty if using local storage only

# Path to Firebase service account key JSON file
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/serviceAccountKey.json

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Enable Firebase integration (true/false)
ENABLE_FIREBASE=false

# ============================================
# Email Configuration (Optional but Recommended)
# ============================================
# Configure to send password reset emails and welcome emails
# Leave empty to show codes in console (testing mode)

# SMTP Server Address
MAIL_SERVER=

# SMTP Port (usually 587 for TLS or 465 for SSL)
MAIL_PORT=587

# Email account username
MAIL_USERNAME=

# Email account password or app password
MAIL_PASSWORD=

# Sender email address
MAIL_FROM=noreply@agripinya.com

# ============================================
# Email Provider Examples
# ============================================

# GMAIL (with Gmail App Password):
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-16-char-app-password

# SENDGRID:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.your-sendgrid-api-key

# MAILGUN:
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@yourdomain.mailgun.org
# MAIL_PASSWORD=your-mailgun-password

# AWS SES:
# MAIL_SERVER=email-smtp.region.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=your-ses-smtp-username
# MAIL_PASSWORD=your-ses-smtp-password
